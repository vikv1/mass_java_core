import java.util.Vector;
import java.util.Iterator;
import java.awt.image.BufferedImage;
import java.awt.Color;
import javax.imageio.ImageIO;
import java.io.File;


public class PixelData {

	private Vector<Mcu> mcus;
	private int mcuCount;
	private int currentIndex;
	private int xSub;
	private int ySub;
	private int xMcus;
	private int yMcus;
	private int xDimension;
	private int yDimension;
	private int actualX;
	private int actualY;
	private int nextMcu;
	private Pixel [][] pixels;

	public PixelData(int x, int y){

		xDimension = x;
		yDimension = y;
		actualX = x;
		actualY = y;
		// If the dimensions don't end right on an MCU boundary, then we need some extra space to write
		// out the dummy pixels
		if(x % 16 != 0){
			actualX += 16 - (x % 16);
		}
		if(y % 16 != 0){
			actualY += 16 - (y % 16);
		}
		
		
		mcus = new Vector<Mcu>((actualX / 16) * (actualY / 16));
		mcuCount = mcus.capacity();
		System.out.println("No. of mcu: " + ((actualX / 16 - 1) * (actualY / 16 - 1)));
		//System.out.println((int)(((Math.ceil((xDimension / 16.0)) * 2)) * (Math.ceil((yDimension / 16.0)) * 2)));
		//mcus.setSize((actualX / 8) * (actualY / 8));
		currentIndex = 0;

		xMcus = actualX / 8;
		yMcus = actualY / 8;

		//pixels = new Pixel[16][16];
		pixels = new Pixel[actualX][actualY];
		nextMcu = 0;
		
	}

	public void setMode(int x, int y){
		xSub = x;
		ySub = y;
	}

	public void addMcu(Mcu newMcu){
		mcus.add(newMcu);
		currentIndex++;
	}

	public Mcu getMcu(int index){
		return mcus.get(index);
	}

	public int getMcuCount(){
		return mcus.size();
	}

	public void addMcus(Mcu[] newMcus){

		int xMode = newMcus[0].getXMode();
		int yMode = newMcus[0].getYMode();

		int newMcuIndex = 0;
		for(int i = 0; i < yMode; i++){
			for(int j = 0; j < xMode; j++){
				// The indexing has to account for the fact that for each row that a group of mcus
				// cover, the index must be increased by xMcus
				System.out.println("Adding MCU# : " + (nextMcu + j + (i * xMcus)));
				if((nextMcu + j + i * xMcus) < mcus.size()){
					mcus.set(nextMcu + j + i * xMcus, newMcus[newMcuIndex++]);
				}
			}
		}
		
		nextMcu += xMode;
		if(nextMcu % xMcus == 0){
			nextMcu += xMcus;
		}
		
//		for(int i = 0; i < newMcus.length; i++){
//			mcus.add(newMcus[i]);
//		}
	}
	
	public void quantizeY(QuantizationTable q){
		
		Iterator<Mcu> mcuIter = mcus.iterator();
		while(mcuIter.hasNext()){
			Mcu current = mcuIter.next();
			if (current == null)
				break;
			for(int yBlock = 0; yBlock < current.getXMode() * current.getYMode(); yBlock++)
				for(int i = 0; i < 64; i++){
					current.setY(yBlock, current.getZigZagY(yBlock, i) * q.getElement(i), i);
				}
		}
	}
		
	public void quantizeCbCr(QuantizationTable q){
		Iterator<Mcu> mcuIter = mcus.iterator();
		while(mcuIter.hasNext()){
			Mcu current = mcuIter.next();
			for(int i = 0; i < 64; i++){
				current.setCb(current.getZigZagCb(i) * q.getElement(i), i);
				current.setCr(current.getZigZagCr(i) * q.getElement(i), i);
			}
		}

		
	}
	
	public void populatePixels(){
		int yDc, cbDc, crDc;
		
		int xOffset, yOffset, xOffsetInMcu, yOffsetInMcu;
		xOffset = yOffset = xOffsetInMcu = yOffsetInMcu = 0;
		yDc = cbDc = crDc = 0;
		//for(int i = 0; i < mcus.size() ; i++){
		for(int i = 0; i < mcuCount ; i++){
	//	for(int i = 0; i < 1 ; i++){
			//System.out.println("Current MCU: " + i);
			Mcu current = mcus.get(i);
			
			cbDc += current.getZigZagCb(0);
			crDc += current.getZigZagCr(0);
			current.setCr(crDc, 0);
			current.setCb(cbDc, 0);
			
			xOffsetInMcu = 0;
			yOffsetInMcu = 0;
			int cbCrXCounter, cbCrYCounter;
			cbCrXCounter = cbCrYCounter = 0;
			for(int currentYBlock = 0; currentYBlock < 4; currentYBlock++){
				cbCrXCounter = (currentYBlock % 2) * 4;
				cbCrYCounter = (currentYBlock / 2) * 4;
				yDc += current.getZigZagY(currentYBlock, 0);	
				current.setY(currentYBlock, yDc, 0);
				int cb, cr, y0, y1, y2, y3;
//				for(int j = 0; j < 4; j++){
//					for(int k = 0; k < 4; k++){
				
				
				for(int k = 0; k < 4; k++){
					for(int j = 0; j < 4; j++){
								
						y0 = yIDCT(currentYBlock, (j * 2), (k * 2), current);						
						y1 = yIDCT(currentYBlock, (j * 2), (k * 2) + 1, current);							
						y2 = yIDCT(currentYBlock, (j * 2) + 1, (k * 2), current);							
						y3 = yIDCT(currentYBlock, (j * 2) + 1, (k * 2) + 1, current);						
						cb = cbIDCT(cbCrXCounter, cbCrYCounter, current);
						cr = crIDCT(cbCrXCounter++, cbCrYCounter, current);


						//System.out.println("Pixel : " + ((j * 2) + xOffsetInMcu + xOffset) + ", " + ((k * 2) + yOffsetInMcu + yOffset));
						pixels[(j * 2) + xOffsetInMcu + xOffset][(k * 2) + yOffsetInMcu + yOffset] = new Pixel(y0, cb, cr);
						pixels[(j * 2) + xOffsetInMcu + xOffset][(k * 2) + 1 + yOffsetInMcu + yOffset] = new Pixel(y1, cb, cr);
						pixels[(j * 2) + 1 + xOffsetInMcu + xOffset][(k * 2) + yOffsetInMcu + yOffset] = new Pixel(y2, cb, cr);
						pixels[(j * 2) + 1 + xOffsetInMcu + xOffset][(k * 2) + 1 + yOffsetInMcu + yOffset] = new Pixel(y3, cb, cr);
					}
					cbCrXCounter = (currentYBlock % 2) * 4;
					cbCrYCounter++;
				}
						
				xOffsetInMcu += 8;
				xOffsetInMcu %= 16;
				if(xOffsetInMcu == 0){
					yOffsetInMcu += 8;
				}				
			}
			//System.out.println("End of MCU");
			//System.out.println(i);
			// Set offset so that we're pointing at the next MCU
			xOffset += 16;
			
			// When we reach the end of a row, xOffset should be set back to 0
			xOffset %= 8 * xMcus;

			// At a new row, set the yOffset to the next row
			if(xOffset == 0){
				yOffset += 16;
			} 
			
		}
		BufferedImage b = new BufferedImage(xDimension, yDimension, BufferedImage.TYPE_INT_RGB);
		//BufferedImage b = new BufferedImage(16, 16, BufferedImage.TYPE_INT_RGB);
		
		for(int y = 0; y < yDimension; y++){
			for(int x = 0; x < xDimension; x++){

				//System.out.println(x + ", " + y);
				//Color c = new Color(pixels.get(y * actualX + x).r, pixels.get(y * actualX + x).g, pixels.get(y * actualX + x).b);
				Color c = new Color(pixels[x][y].r, pixels[x][y].g, pixels[x][y].b);
				b.setRGB(x, y, c.getRGB());

			}

		}
		try{
			ImageIO.write(b, "BMP", new File("output.bmp"));
		} catch (Exception e){};
		
	}
	
	private int yIDCT(int targetBlock, int x, int y, Mcu mcu){
		double value = 0;
		for(int u = 0; u < 8; u++){
			for(int v = 0; v < 8; v++){
				double usig = getSigma(u);
				double vsig = getSigma(v);
				int yVal = mcu.getY(targetBlock, u + (v * 8));
				double cos1 = Math.cos((Math.PI / 8) * (x + .5) * u);
				double cos2 = Math.cos((Math.PI / 8) * (y + .5) * v);
						
				value += getSigma(u) * getSigma(v) * mcu.getY(targetBlock, (v * 8) + u) * Math.cos((Math.PI / 8) * (x + .5) * u) * Math.cos((Math.PI / 8) * (y + .5) * v);
				//System.out.println(value);
			}
		}
		return (int)Math.rint(value);
	}
	
	private int cbIDCT(int x, int y, Mcu mcu){
		double value = 0;
		for(int u = 0; u < 8; u++){
			for(int v = 0; v < 8; v++){		
				value += getSigma(u) * getSigma(v) * mcu.getCb((v * 8) + u) * Math.cos((Math.PI / 8) * (x + .5) * u) * Math.cos((Math.PI / 8) * (y + .5) * v);
				//value += getSigma(u) * getSigma(v) * mcu.getCb((v * 8) + u) * Math.cos((Math.PI / 8) * (x + .5) * u) * Math.cos((Math.PI / 8) * (y + .5) * v);
			}
		}
		return (int)Math.rint(value);
	}
	private int crIDCT(int x, int y, Mcu mcu){
		double value = 0;
		for(int u = 0; u < 8; u++){
			for(int v = 0; v < 8; v++){
				value += getSigma(u) * getSigma(v) * mcu.getCr((v * 8) + u) * Math.cos((Math.PI / 8) * (x + .5) * u) * Math.cos((Math.PI / 8) * (y + .5) * v);
				//System.out.println(value);
			}
		}
		return (int)Math.rint(value);
	}
	private double getSigma(int u){
		if(u == 0){
			return 0.35355339;
		}
		
		return 0.5;
	}
}
